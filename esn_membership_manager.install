/**
 * @throws InvalidPluginDefinitionException
 * @throws PluginNotFoundException
 * @throws Exception
 */
function esn_membership_manager_update_3001(&$sandbox): ?TranslatableMarkup
{
    $database = Drupal::database();
    $entityTypeManager = Drupal::entityTypeManager();
    $updateManager = Drupal::entityDefinitionUpdateManager();

    if (!isset($sandbox['total'])) {
        $sandbox['total'] = (int)$database->query('SELECT COUNT(id) FROM {esn_membership_manager_applications}')->fetchField();
        $sandbox['current'] = 0;

        if (!$updateManager->getEntityType('membership_application')) {
            $updateManager->installEntityType($entityTypeManager->getDefinition('membership_application'));
        }

        if ($sandbox['total'] === 0) {
            $sandbox['#finished'] = 1;
            return t('No records to migrate.');
        }
    }

    /** @var ApplicationStorage $storage */
    $storage = $entityTypeManager->getStorage('membership_application');

    $query = $database->select('esn_membership_manager_applications', 'a')
        ->fields('a')
        ->range($sandbox['current'], 50)
        ->orderBy('id');

    $results = $query->execute()->fetchAll();

    foreach ($results as $row) {
        $storage->create()
            ->set('id', $row->id)
            ->setValue(ApplicationField::Name, $row->name)
            ->setValue(ApplicationField::Surname, $row->surname)
            ->setValue(ApplicationField::Email, $row->email)
            ->setValue(ApplicationField::Nationality, $row->nationality)
            ->setValue(ApplicationField::DateOfBirth, $row->dob)
            ->setValue(ApplicationField::MobilityStatus, $row->mobility_status)
            ->setValue(ApplicationField::Section, $row->section)
            ->setValue(ApplicationField::HostInstitution, $row->host_institution)
            ->setValue(ApplicationField::StatusProofFileID, $row->proof_fid)
            ->setValue(ApplicationField::IdentityDocumentFileID, $row->id_document_fid)
            ->setValue(ApplicationField::FacePhotoFileID, $row->face_photo_fid)
            ->setValue(ApplicationField::HasVerifiedEmail, $row->verified_email)
            ->setValue(ApplicationField::HasVerifiedID, $row->verified_id)
            ->setValue(ApplicationField::HasVerifiedStatus, $row->verified_status)
            ->setValue(ApplicationField::HasESNcard, $row->esncard)
            ->setValue(ApplicationField::PassToken, $row->pass_token)
            ->setValue(ApplicationField::ESNcardNumber, $row->esncard_number)
            ->setValue(ApplicationField::PaymentLink, $row->payment_link)
            ->setValue(ApplicationField::PaymentLinkID, $row->payment_link_id)
            ->setValue(ApplicationField::ApprovalStatus, $row->approval_status)
            ->setValue(ApplicationField::DateCreated, $row->date_created ? (new DrupalDateTime($row->date_created))->format('Y-m-d\TH:i:s') : null)
            ->setValue(ApplicationField::DateApproved, $row->date_approved ? (new DrupalDateTime($row->date_approved))->format('Y-m-d\TH:i:s') : null)
            ->setValue(ApplicationField::DatePaid, $row->date_paid ? (new DrupalDateTime($row->date_paid))->format('Y-m-d\TH:i:s') : null)
            ->setValue(ApplicationField::DateLastScanned, $row->date_last_scanned ? (new DrupalDateTime($row->date_last_scanned))->format('Y-m-d\TH:i:s') : null)
            ->setValue(ApplicationField::DateLastModified, $row->date_last_modified ? (new DrupalDateTime($row->date_last_modified))->format('Y-m-d\TH:i:s') : null)
            ->enforceIsNew()
            ->save();

        $sandbox['current']++;
    }

    if ($sandbox['total'] > 0) {
        $sandbox['#finished'] = $sandbox['current'] / $sandbox['total'];
    } else {
        $sandbox['#finished'] = 1;
    }

    if ($sandbox['#finished'] >= 1) {
        return t("Successfully migrated all {$sandbox['total']} applications to the new entity format.");
    }

    return null;
}

/**
 * @throws PluginNotFoundException
 */
function esn_membership_manager_update_3002(): void
{
    $entityTypeManager = Drupal::entityTypeManager();
    $updateManager = Drupal::entityDefinitionUpdateManager();

    if (!$updateManager->getEntityType('membership_guest')) {
        $updateManager->installEntityType($entityTypeManager->getDefinition('membership_guest'));
    }
}