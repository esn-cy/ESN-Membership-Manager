{
  "name": "esn-cy/esn-membership-manager",
  "type": "drupal-module",
  "description": "Provides a framework to accept applications for both Free Passes and ESNcards.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/esn-cy/esn-membership-manager",
  "readme": "README.MD",
  "support": {
    "email": "wpa@esncy.org",
    "issues": "https://github.com/esn-cy/esn-membership-manager/issues"
  },
  "authors": [
    {
      "name": "Andreas Michael",
      "email": "ateasm03@gmail.com",
      "role": "Developer"
    },
    {
      "name": "Charilaos Mikelli",
      "email": "charilaosmikelli@gmail.com",
      "role": "Original Concept Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Drupal\\esn_membership_manager\\": "src/"
    }
  },
  "require": {
    "esn-cy/core": "^1.0",
    "esn/esn_accounts_api": "^1.1",
    "drupal/simple_oauth": "^6.1",
    "google/apiclient-services": "^0.441",
    "tecnickcom/tcpdf": "^6.11",
    "thenetworg/oauth2-azure": "^2.2",
    "ext-gd": "*",
    "ext-openssl": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "drupal/core": "^10"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "drupal/core-vendor-hardening": true,
      "drupal/core-recipe-unpack": true,
      "drupal/core-project-message": true
    }
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    "esn": {
      "type": "composer",
      "url": "https://packages.esn.org"
    }
  }
}
