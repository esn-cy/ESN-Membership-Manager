<style>
    @import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap');

    :root {
        --esn-cyan: #00AEEF;
        --esn-magenta: #EC008C;
        --esn-green: #7AC143;
        --esn-orange: #F47B20;
        --esn-darkblue: #2E3192;
    }

    .esncard-container {
        all: initial;
        font-family: Lato, sans-serif;
        display: flex;
        position: relative;
        width: min-content;
        border: 1px solid black;
        border-radius: 10px;
    }

    .esncard-container * {
        box-sizing: border-box;
    }

    .esncard-container label {
        font-family: Lato, sans-serif;
        font-size: 8.5px;
    }

    .esncard-right {
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        padding: 10px 20px;
    }

    .esncard-right input {
        border: none;
        border-radius: 5px;
        width: 218px;
        padding: 5px;
        background-color: #00AEEF7F;
        font-size: 12px;
    }

    .esncard-right input::placeholder {
        color: #666;
    }

    .date-split-container {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .date-split-container label:first-child input {
        width: 125px !important;
    }

    .date-split-container label:last-child {
        text-align: right;
    }

    .date-input {
        display: flex;
        flex-direction: row;
        gap: 2.5px;
    }

    .date-input input {
        width: 3.5ch;
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
        transition: background-color calc(infinity * 1s) ease-in-out 0s;
    }

    .esncard-left {
        background: linear-gradient(to bottom left, var(--esn-cyan) 0, var(--esn-darkblue));
        padding: 20px;
        border-radius: 10px 0 0 10px;
    }

    .photo-container {
        display: flex;
        position: relative;
        height: 200px;
        width: 150px;
        background: rgba(250, 250, 250, 0.15);
        border-radius: 10px;
        margin-top: 5px;
        object-fit: cover;
    }

    .card-logo {
        height: 22.5px;
        margin-left: auto;
    }

    .barcode {
        width: 200px;
        align-self: center;
    }
</style>

<div class="esncard-container">
    <div class="esncard-left">
        <span style="font-family: Lato, sans-serif; font-size: 14px; color: white;">ESNcard</span>
        <br>
        <span style="font-family: Lato, sans-serif; font-weight: lighter; font-size: 14px; color: white">Member of the<br>Erasmus Generation</span>
        <img class="photo-container" src="{{ face_photo_link }}" alt="Face Picture"/>
    </div>
